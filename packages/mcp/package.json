{
	"name": "@0xnatal/coros-mcp",
	"version": "0.1.0",
	"description": "MCP server for the COROS Training Hub web API — exposes training data to AI assistants",
	"keywords": [
		"coros",
		"mcp",
		"training",
		"fitness",
		"hrv",
		"claude"
	],
